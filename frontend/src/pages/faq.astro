---
export const prerender = true;
import BaseLayout from "../layouts/base_layout.astro";

const faqs = [
  {
    q: "¿Cómo sé si mi ejemplar tiene un Billete Dorado?",
    a: "Los Billetes Dorados están insertados en ejemplares seleccionados aleatoriamente durante la impresión. Cada billete incluye un código único impreso en dorado.",
  },
  {
    q: "¿Puedo participar más de una vez?",
    a: "Sí, pero solo una vez por código. Si tienes varios Billetes Dorados, puedes registrar cada uno con el mismo email. Cada código da derecho a una tirada de ruleta.",
  },
  {
    q: "¿Qué pasa si introduzco el código y me dice que ya está utilizado?",
    a: "Significa que ese código ya fue registrado. Si crees que es un error, contacta con nosotros a través del formulario de soporte indicando el código y el ejemplar donde lo encontraste.",
  },
  {
    q: "¿Cuándo se entregan los premios?",
    a: "Los premios digitales (cheques regalo, suscripciones) se entregan en un plazo de 48 horas tras la participación. Los premios físicos se gestionan en las 2-4 semanas posteriores al cierre de la campaña el 15 de junio de 2026.",
  },
  {
    q: "¿Es necesario aceptar las comunicaciones de marketing para participar?",
    a: "No. El consentimiento de marketing es completamente opcional. Solo es obligatorio aceptar las bases legales del sorteo.",
  },
  {
    q: "¿Qué hago si tengo problemas técnicos durante el registro?",
    a: "Prueba a limpiar la caché de tu navegador o usa un navegador diferente. Si el problema persiste, escríbenos a soporte@mainpaper.es indicando el código de tu billete.",
  },
];
---

<BaseLayout
  title="Preguntas Frecuentes — MP Billete Dorado 2026"
  description="Resuelve tus dudas sobre el sorteo MP Billete Dorado 2026. Cómo participar, premios, plazos y soporte."
>
  <div class="mx-auto max-w-3xl px-4 py-16">
    <a href="/" class="text-sm text-yellow-600 hover:underline mb-6 inline-block">← Volver al inicio</a>
    <h1 class="text-3xl font-extrabold text-gray-900 mb-2">Preguntas Frecuentes</h1>
    <p class="text-gray-500 mb-10">Todo lo que necesitas saber sobre el sorteo MP Billete Dorado 2026.</p>

    <div class="space-y-4">
      {faqs.map(({ q, a }, i) => (
        <details
          class="group rounded-xl border border-gray-200 bg-white px-6 py-4 cursor-pointer open:shadow-sm transition-shadow"
        >
          <summary class="flex items-center justify-between font-semibold text-gray-900 list-none">
            <span>{q}</span>
            <svg
              class="h-5 w-5 text-gray-400 flex-shrink-0 ml-4 transition-transform group-open:rotate-180"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <p class="mt-3 text-sm text-gray-600 leading-relaxed">{a}</p>
        </details>
      ))}
    </div>

    <div class="mt-12 rounded-2xl bg-yellow-50 border border-yellow-200 p-6 text-center">
      <p class="font-semibold text-gray-900 mb-2">¿No encontraste tu respuesta?</p>
      <p class="text-sm text-gray-500 mb-4">Nuestro equipo está disponible para ayudarte.</p>
      <a
        href="mailto:soporte@mainpaper.es"
        class="inline-block rounded-lg bg-yellow-500 hover:bg-yellow-600 text-white font-semibold px-6 py-2 text-sm transition-colors"
      >
        Contactar soporte
      </a>
    </div>
  </div>
</BaseLayout>
