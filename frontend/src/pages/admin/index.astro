---
import AdminLayout from "../../layouts/admin-layout.astro";
import { StatsBar } from "../../components/admin/stats-bar";
---

<AdminLayout title="Dashboard" currentPath="/admin">
  <div class="max-w-5xl mx-auto flex flex-col gap-8">
    <div>
      <h1 class="text-2xl font-extrabold text-gray-900">Dashboard</h1>
      <p class="mt-1 text-sm text-gray-500">
        Estadísticas globales de la campaña. Se actualizan cada 30 segundos.
      </p>
    </div>

    <!-- Stats con polling (client:idle = se hidrata cuando el navegador está libre) -->
    <StatsBar client:idle />

    <!-- Accesos rápidos -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <a
        href="/admin/premios"
        class="flex flex-col gap-2 rounded-2xl border border-gray-200 bg-white p-6 hover:border-yellow-300 hover:shadow-sm transition-all"
      >
        <span class="text-2xl" aria-hidden="true">🎁</span>
        <h2 class="font-bold text-gray-900">Gestión de Premios</h2>
        <p class="text-sm text-gray-500">
          Activa o desactiva premios y consulta el stock restante.
        </p>
      </a>

      <a
        href="/admin/fraude"
        class="flex flex-col gap-2 rounded-2xl border border-gray-200 bg-white p-6 hover:border-yellow-300 hover:shadow-sm transition-all"
      >
        <span class="text-2xl" aria-hidden="true">🚩</span>
        <h2 class="font-bold text-gray-900">Flags de Fraude</h2>
        <p class="text-sm text-gray-500">
          Revisa participaciones marcadas e invalida las fraudulentas.
        </p>
      </a>
    </div>
  </div>
</AdminLayout>
