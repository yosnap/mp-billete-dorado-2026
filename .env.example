# ============================================================
# MP Billete Dorado 2026 — Variables de entorno
# Copiar a .env y rellenar los valores reales.
# NUNCA commitear el .env con valores reales.
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=mpbillete
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=mp_billete_dorado
# Solo accesible dentro de la red Docker interna
DATABASE_URL=postgresql+asyncpg://mpbillete:change-me-strong-password@postgres:5432/mp_billete_dorado

# --- Redis ---
# Contraseña obligatoria (requirepass en redis.conf)
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:change-me-redis-password@redis:6379/0

# --- Celery ---
CELERY_BROKER_URL=redis://:change-me-redis-password@redis:6379/1
CELERY_RESULT_BACKEND=redis://:change-me-redis-password@redis:6379/2

# --- FastAPI ---
APP_ENV=development
DEBUG=false
SECRET_KEY=change-me-secret-key-min-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALLOWED_ORIGINS=["http://localhost","http://localhost:4321"]

# --- Admin API ---
# Token para el endpoint POST /api/v1/admin/codes/import
# Generar con: openssl rand -hex 32
ADMIN_TOKEN=change-me-admin-token-min-32-chars

# --- Astro ---
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# O con openssl: openssl rand -hex 32
ASTRO_KEY=your-astro-key-here
